# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real keys.

# Required to use the real OpenAI API (Layer 4). Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Which LLM backend Layer 4 uses. "openai" (default) or "mock" (no
# network calls, for testing — see utils/llm_client.py MockLLMClient).
LLM_PROVIDER=openai

# Model name. Defaults to gpt-5-nano (cheapest OpenAI text model) if unset.
LLM_MODEL=gpt-5-nano

# Optional: a separate, stronger model for the one reasoning-heavy Layer 4
# task (root_cause_analysis, which weighs conflicting evidence rather than
# classify/extract). Falls back to LLM_MODEL if unset.
# LLM_REASONING_MODEL=gpt-5-mini

# Uncomment to point at a local OpenAI-compatible server instead of the
# real OpenAI API (e.g. Ollama, vLLM, LM Studio). OPENAI_API_KEY can be
# any placeholder value in this case — most local servers ignore it.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3
